# Copy to agent/.env and fill in, or just export these in your shell.
# .env is gitignored; nothing here is committed.

# Anthropic — the matcher and the board assistant.
# An `ant auth login` profile works too; the SDK finds either.
ANTHROPIC_API_KEY=

# Todoist — Settings > Integrations > Developer > API token.
TODOIST_API_TOKEN=

# Defaults the agent uses when a board comment doesn't override them
# (e.g. "@claude cut folder:'B-Roll Sept 12' list:Reshoots").
SCENEFLOW_DRIVE_FOLDER=SceneFlowDemo
SCENEFLOW_TODOIST_PROJECT="Shoot List"
SCENEFLOW_RESOLVE_PROJECT=Sceneflow

# Confidence below which a match is downgraded to "unshot" and filed
# as a task instead of cut into the timeline. Raise it to make the
# agent more cautious; eval/ measures the tradeoff.
SCENEFLOW_MATCH_THRESHOLD=0.55

# Google Drive OAuth lives in agent/.state/, not here:
#   agent/.state/drive-client.json   <- your Desktop-app OAuth client
#   agent/.state/drive-token.json    <- written by: npm run auth:drive
